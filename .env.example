# Contest entry email delivery
# Prefer Resend (https://resend.com). If unset, SMTP is tried next; otherwise sandbox logs only.

RESEND_API_KEY=
# Verified sender, e.g. Contest <entries@yourdomain.com>
CONTEST_FROM_EMAIL=Contest <onboarding@resend.dev>

# Optional Nodemailer / SMTP fallback when RESEND_API_KEY is empty
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Contest inbox is hard-coded to contact@ampbrand.com in sendContestEmail.ts

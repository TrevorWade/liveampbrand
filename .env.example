# Contest entry email delivery
# Prefer Resend (https://resend.com). If unset, SMTP is tried next; otherwise sandbox logs only.

RESEND_API_KEY=
# REQUIRED in production: must be a Resend-verified domain (not onboarding@resend.dev).
# Example matches the main AMP Brand site contact form sender.
CONTEST_FROM_EMAIL=Contest <no-reply@ampbrand.com>

# Optional Nodemailer / SMTP fallback when RESEND_API_KEY is empty
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Contest inbox is hard-coded to contact@ampbrand.com in sendContestEmail.ts
